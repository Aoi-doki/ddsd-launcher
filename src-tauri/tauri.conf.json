{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DDSD Launcher",
  "version": "2.0.0",
  "identifier": "moe.aoi.ddsd.launcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "windows": [
      {
        "title": "Doki Doki Second Draft",
        "width": 920,
        "height": 600,
        "minWidth": 760,
        "minHeight": 520,
        "resizable": true,
        "center": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
